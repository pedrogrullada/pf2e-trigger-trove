      "id": "h62yKXrN5IeEXKBg",
      "inputs": {
        "script": {
          "value": "/**\n * @param {unknown[]} inputs\n * @returns {boolean} to break out current process\n * @returns {{type: EntryType; value: unknown}[]}\n *\n * @example\n * const x = inputs[0];\n * const y = inputs[1];\n * return [{type: \"number\", value: x + y}];\n */\n\nconst msg = inputs[0];\n\nconst isValid = msg?.isDamageRoll\n   && msg?.flags?.pf2e?.context?.outcome === 'criticalSuccess'\n  && (msg?.flags?.pf2e?.context?.options?.includes(\"critical-specialization\"))\nconst roll = msg?.rolls?.[0];\n\nconst data = roll?.options?.damage?.damage?.base?.map(d => (\n  {\n    type: d.damageType, \n    faces: Number( d.dieSize?.replace(\"d\", \"\"))\n  }))\n\nconst dmg = roll?.terms?.[0].rolls?.find(r => \n  data?.some(d => d.type === r?.type && d?.faces === r?.dice?.[0]?.faces))\nconsole.log(dmg)\n\nconst total = Math.floor((dmg?.dice?.[0]?.total ?? 0) /2 );\nconst type = dmg?.type ?? \"\"\n\nreturn [\n  {type: \"boolean\", value: isValid},\n  {type: \"number\", value: total},\n  {type: \"target\", value: msg?.token},\n  {type: \"boolean\", value: msg?.item},\n  {type: \"target\", value: msg?.target},\n  {type: \"text\", value: type}\n];"
        },
